{
  "7627827559246167599": {
    "build": {
      "command": "next build",
      "options": {
        "cwd": "apps/live-sync",
        "tty": false
      },
      "dependsOn": [
        "^build"
      ],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": [
            "next"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/apps/live-sync/.next",
        "{workspaceRoot}/apps/live-sync/.next/!(cache)"
      ]
    },
    "dev": {
      "command": "next dev",
      "options": {
        "cwd": "apps/live-sync"
      }
    },
    "start": {
      "command": "next start",
      "options": {
        "cwd": "apps/live-sync"
      },
      "dependsOn": [
        "build"
      ]
    },
    "serve-static": {
      "command": "next start",
      "options": {
        "cwd": "apps/live-sync"
      },
      "dependsOn": [
        "build"
      ]
    },
    "build-deps": {
      "dependsOn": [
        "^build"
      ]
    },
    "watch-deps": {
      "dependsOn": [
        "build-deps"
      ],
      "command": "pnpm exec nx watch --projects live-sync --includeDependentProjects -- pnpm exec nx build-deps live-sync"
    }
  },
